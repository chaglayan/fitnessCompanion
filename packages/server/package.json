{
  "name": "@fc/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "node --watch --experimental-strip-types --disable-warning=ExperimentalWarning src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "test": "npm run build && node --test --disable-warning=ExperimentalWarning dist/*.test.js dist/**/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@fc/shared": "*",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5"
  }
}
