# ---------------------------------------------------------------------------
# Fitness Companion — server configuration
# Copy to .env and fill in. Nothing here is sent anywhere except your AI
# provider; the API key never leaves this machine.
# ---------------------------------------------------------------------------

# Shared secret your laptop and phone send as `Authorization: Bearer <token>`.
# Generate one with:  node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
AUTH_TOKEN=

# Set true ONLY if this server is unreachable from outside your machine.
# ALLOW_NO_AUTH=true

PORT=8080
HOST=0.0.0.0
DB_PATH=./data/fitness.sqlite

# Comma-separated allowed origins, or * for a LAN-only box.
CORS_ORIGINS=*

# --- AI provider ------------------------------------------------------------
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
# Only needed for identity-linked keys, which are scoped to a workspace and
# reject every request without it. Find it at console.anthropic.com →
# Settings → Workspaces (the id in the URL, starting "wrkspc_"). If your key
# works without this, leave it blank.
ANTHROPIC_WORKSPACE_ID=

# Used when AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Gemini prices are not bundled — copy them from Google's current pricing page
# so the usage ledger reports real numbers instead of zero.
# GEMINI_INPUT_USD_PER_MTOK=
# GEMINI_OUTPUT_USD_PER_MTOK=

# --- Cost control -----------------------------------------------------------
# Thinking depth. Planning is a well-specified, structured task, so "low" is
# usually enough. Raise to medium/high if sessions feel shallow.
AI_PLAN_EFFORT=low
AI_CHAT_EFFORT=low

# Hard rolling-30-day ceiling in USD. When it is hit, AI calls stop and every
# session falls back to the deterministic planner instead of failing. 0 = off.
AI_MONTHLY_BUDGET_USD=5

# How long an identical plan request is reused from cache, in minutes.
PLAN_CACHE_TTL_MIN=720

# Set false to route every session through the model (for testing only — this
# turns off the single biggest cost saving in the app).
PLANNER_FIRST=true
